/* Explicit light surfaces keep text legible with Windows light and dark themes. */
QWidget {
    color: #182b3a;
    font-family: "Segoe UI";
    font-size: 13px;
    selection-background-color: #165d96;
    selection-color: #ffffff;
}
QMainWindow, QDialog, QMessageBox, QWidget#centralwidget {
    background-color: #f3f6fa;
}
QLabel {
    color: #182b3a;
    background-color: transparent;
    padding: 5px;
}
QLabel:disabled { color: #586777; }
QPushButton {
    background-color: #17649b;
    color: #ffffff;
    border: 1px solid #17649b;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 18px;
}
QPushButton:hover:enabled { background-color: #124f7d; border-color: #124f7d; }
QPushButton:pressed:enabled { background-color: #0d3d63; }
QPushButton:focus { border: 2px solid #102f49; padding: 7px 11px; }
QPushButton:disabled {
    background-color: #e0e6ed;
    border-color: #b7c2cd;
    color: #536171;
}
QPushButton#registerButton {
    background-color: #ffffff;
    color: #124f7d;
    border-color: #17649b;
}
QPushButton#registerButton:hover:enabled { background-color: #e3effa; }
QPushButton#registerButton:disabled { background-color: #e0e6ed; color: #536171; border-color: #b7c2cd; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    color: #182b3a;
    background-color: #ffffff;
    border: 1px solid #8193a5;
    border-radius: 5px;
    padding: 7px;
    min-height: 18px;
    placeholder-text-color: #596b7c;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 2px solid #17649b; padding: 6px; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #e4e9ef;
    color: #536171;
    border-color: #b7c2cd;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #8193a5;
}
QComboBox::down-arrow { image: url(":/img/arrow.png"); width: 16px; height: 16px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #182b3a;
    selection-background-color: #165d96;
    selection-color: #ffffff;
    border: 1px solid #8193a5;
}
QTableView, QListView, QTreeView {
    background-color: #ffffff;
    alternate-background-color: #edf3f9;
    color: #182b3a;
    gridline-color: #ccd6e0;
    border: 1px solid #9eafbf;
    selection-background-color: #165d96;
    selection-color: #ffffff;
}
QTableView::item { padding: 5px; }
QTableView::item:selected { background-color: #165d96; color: #ffffff; }
QTableView::item:hover:!selected { background-color: #e3effa; }
QHeaderView, QHeaderView::section, QTableCornerButton::section {
    background-color: #dde7f0;
    color: #182b3a;
}
QHeaderView::section { padding: 7px; border: 1px solid #b7c7d6; font-weight: 600; }
QMenuBar, QStatusBar { background-color: #e8eef5; color: #182b3a; }
QMenuBar::item { background-color: transparent; padding: 6px 10px; }
QMenuBar::item:selected { background-color: #d1e3f3; color: #123d60; }
QMenu {
    background-color: #ffffff;
    color: #182b3a;
    border: 1px solid #9eafbf;
    padding: 4px;
}
QMenu::item { padding: 8px 24px; }
QMenu::item:selected { background-color: #165d96; color: #ffffff; }
QMenu::item:disabled { color: #586777; }
QMenu::separator { height: 1px; background-color: #ccd6e0; margin: 4px 8px; }
QCheckBox, QRadioButton { color: #182b3a; background-color: transparent; spacing: 7px; }
QCheckBox:disabled, QRadioButton:disabled { color: #586777; }
QGroupBox { color: #182b3a; border: 1px solid #9eafbf; border-radius: 5px; margin-top: 12px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; }
QToolTip { color: #182b3a; background-color: #ffffff; border: 1px solid #8193a5; padding: 6px; }
