/* Przycisk */
QPushButton {
    background-color: #3498db;  /* Niebieskie tło */
    color: white;              /* Biały tekst */
    border-radius: 6px;        /* Zaokrąglone rogi */
    padding: 8px;             /* Odstępy wewnętrzne */
    font-size: 12px;           /* Rozmiar czcionki */
}

QPushButton:disabled {
    background-color: #95a5a6; /* Szare tło przy wyłączeniu */
    color: #7f8c8d;            /* Szary tekst */
}

QPushButton:hover {
    background-color: #1a5276; /* Granatowy, kolor dla hover */
}

/* Menu kontekstowe */
QMenu {
    background-color: #ecf0f1;  /* Jasnoszare tło */
    border: 1px solid #bdc3c7;   /* Szara ramka */
    border-radius: 6px;          /* Zaokrąglone rogi */
}

QMenu::item {
    padding: 8px 18px;          /* Odstępy w menu */
    font-size: 12px;             /* Rozmiar czcionki */
    color: #2c3e50;              /* Ciemny kolor tekstu */
}

QMenu::item:selected {
    background-color: #3498db;   /* Niebieskie tło przy zaznaczeniu */
    color: white;                /* Biały tekst */
}

QMenu::item:disabled {
    color: #95a5a6;              /* Szary tekst dla wyłączonych elementów */
    background-color: transparent; /* Przezroczyste tło */
}

/* Tabela QTableView */
QTableView {
    background-color: #ffffff;   /* Białe tło tabeli */
    border: 1px solid #bdc3c7;   /* Szara ramka */
    border-radius: 8px;          /* Zaokrąglone rogi */
    gridline-color: #bdc3c7;     /* Kolor linii siatki */
}

/* QLineEdit */
QLineEdit {
    background-color: #ecf0f1;   /* Jasnoszare tło */
    border: 1px solid #bdc3c7;    /* Szara ramka */
    border-radius: 6px;           /* Zaokrąglone rogi */
    padding: 8px;                /* Odstępy wewnętrzne */
    font-size: 12px;              /* Rozmiar czcionki */
    color: #2c3e50;               /* Ciemny tekst */
}

QLineEdit:disabled {
    background-color: #bdc3c7;   /* Ciemniejsze tło dla nieaktywnych */
    color: #7f8c8d;              /* Jasnoszary tekst */
}

QLineEdit:focus {
    border-color: #3498db;       /* Niebieska ramka przy focu */
}

/* QLabel */
QLabel {
    color: #2c3e50;               /* Ciemny kolor tekstu */
    font-size: 12px;              /* Rozmiar czcionki */
    padding: 5px;                 /* Odstępy wokół tekstu */
}

QLabel:disabled {
    color: #95a5a6;               /* Jasnoszary tekst dla nieaktywnych */
}

/* Stylizacja dla elementów na hover */
QTableView::item:hover, QLineEdit:focus {
    background-color: #ecf0f1;    /* Jasnoszare tło przy najechaniu */
    color: #2c3e50;               /* Ciemny tekst */
}

/* QSpinBox */
QSpinBox {
    background-color: #ecf0f1;      /* Jasnoszare tło */
    border: 1px solid #bdc3c7;       /* Szara ramka */
    border-radius: 8px;              /* Zaokrąglone rogi */
    padding: 5px;                    /* Odstępy wewnętrzne */
    font-size: 12px;                 /* Rozmiar czcionki */
    color: #2c3e50;                  /* Ciemny tekst */
}

QSpinBox:disabled {
    background-color: #bdc3c7;   /* Ciemniejsze tło dla nieaktywnych */
    color: #7f8c8d;              /* Jasnoszary tekst */
}

QSpinBox:focus {
    border-color: #3498db;           /* Niebieska ramka przy fokusu */
}

/* QComboBox */
QComboBox {
    background-color: #ecf0f1;    /* Jasnoszare tło */
    border: 1px solid #bdc3c7;    /* Szara ramka */
    border-radius: 6px;           /* Zaokrąglone rogi */
    padding: 5px;                 /* Odstępy wewnętrzne */
    font-size: 12px;              /* Rozmiar czcionki */
    color: #2c3e50;               /* Ciemny tekst */
}

QComboBox:disabled {
    background-color: #bdc3c7;    /* Ciemniejsze tło dla nieaktywnych */
    color: #7f8c8d;               /* Jasnoszary tekst */
}

QComboBox::drop-down {
    subcontrol-origin: padding;   /* Ustawienie miejsca rozwijania */
    subcontrol-position: top right; /* Pozycja przycisku */
    width: 20px;                  /* Szerokość przycisku rozwijania */
    border-left: 1px solid #bdc3c7; /* Ramka oddzielająca */
    background-color: #ecf0f1;    /* Tło przycisku rozwijania */
}

QComboBox::down-arrow {
    width: 20px;                  /* Szerokość strzałki */
    height: 20px;                 /* Wysokość strzałki */
    image: url(":/img/arrow.png");  /* Strzałka */
}

QComboBox QAbstractItemView {
    background-color: #ecf0f1;    /* Tło listy rozwijanej */
    border: 1px solid #bdc3c7;    /* Ramka listy rozwijanej */
    selection-background-color: #3498db; /* Tło zaznaczonego elementu */
    selection-color: white;       /* Kolor tekstu zaznaczonego elementu */
    color: #2c3e50;               /* Ciemny tekst dla listy */
    font-size: 12px;              /* Rozmiar czcionki listy */
}
